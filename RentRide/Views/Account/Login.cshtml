@model RentRide.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}
<div class="auth-shell">
    <aside class="auth-visual auth-visual-login">
        <div class="auth-quote"><h2>There’s still so much road ahead.</h2><p>Welcome back. Let’s find your next favorite drive.</p></div>
    </aside>
    <section class="auth-panel">
        <div class="auth-form-wrap">
            <div class="eyebrow">Good to have you back</div>
            <h1>Welcome back.</h1>
            <p class="auth-subtitle">Log in to your RentRide account.</p>
            <form asp-controller="Account" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Your password" />
                    <span asp-validation-for="Password"></span>
                </div>
                <button type="submit" class="btn btn-brand w-100">Log in <span aria-hidden="true">→</span></button>
            </form>
            <p class="auth-switch">New to RentRide? <a asp-action="Signup">Create an account</a></p>
        </div>
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
