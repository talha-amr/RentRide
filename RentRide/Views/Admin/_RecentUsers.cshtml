@model IReadOnlyList<RentRide.Models.ViewModels.AdminRecentUserViewModel>

@if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table dashboard-table">
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Joined</th></tr></thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                        <td><span class="role-pill @(user.Role == "Admin" ? "admin" : "")">@user.Role</span></td>
                        <td>@user.CreatedAt.ToString("MMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state"><h3>No accounts yet</h3><p>New registrations will appear here.</p></div>
}
