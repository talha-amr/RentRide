@model IReadOnlyList<RentRide.Models.Car>

@if (Model.Count == 0)
{
    <div class="empty-state"><h3>No cars available right now</h3><p>Please check back later.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table dashboard-table">
            <thead><tr><th>Car</th><th>Year</th><th>Daily rate</th></tr></thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td class="fw-semibold">@car.Make @car.Model</td>
                        <td>@car.Year</td>
                        <td>@car.DailyRate.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
