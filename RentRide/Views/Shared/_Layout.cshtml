<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentRide</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg site-nav">
        <div class="container">
            <a class="navbar-brand brand-lockup" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">R</span>
                <span>rent<span class="brand-accent">ride</span><small>MOVE WITH CONFIDENCE</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="fleet">Our fleet</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="how-it-works">How it works</a></li>
                </ul>
                <div class="nav-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-user" asp-controller="@(User.IsInRole("Admin") ? "Admin" : "Member")" asp-action="Index">
                            <span class="user-dot"></span>@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-dark btn-sm">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-login" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-brand btn-sm" asp-controller="Account" asp-action="Signup">Get started <span aria-hidden="true">→</span></a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <main role="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-main">
            <a class="brand-lockup footer-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">R</span>
                <span>rent<span class="brand-accent">ride</span><small>MOVE WITH CONFIDENCE</small></span>
            </a>
            <p>Good journeys start with a better drive.</p>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="fleet">Our fleet</a>
                <a asp-controller="Account" asp-action="Signup">Create an account</a>
            </div>
        </div>
        <div class="container footer-bottom"><span>© @DateTime.Now.Year RentRide. All rights reserved.</span><span>Made for the road ahead.</span></div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>